# Copy to .env.local. Never commit .env.local – it is git-ignored.
#
# Local development: run `npx supabase start`, then copy the API URL and the
# publishable key from `npx supabase status`.
# Vercel preview/production get the hosted project's values from Vercel env.
#
# Only the publishable key goes here. Never put a Supabase secret key
# (sb_secret_…) or the service_role key in .env.local or in the repo.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
